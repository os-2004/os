#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, j, head, a[20], temp;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    // Sorting
    for(i = 0; i < n-1; i++)
    {
        for(j = i+1; j < n; j++)
        {
            if(a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence: ");

    // Moving towards higher cylinder numbers
    for(i = 0; i < n; i++)
    {
        if(a[i] >= head)
        {
            printf("%d ", a[i]);
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    // Jump to lowest request
    for(i = 0; i < n; i++)
    {
        if(a[i] < head)
        {
            printf("%d ", a[i]);
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
