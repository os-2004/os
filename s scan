#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[20], n, head, i, j, temp;
    int total = 0, size = 200;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    // Sort requests
    for(i = 0; i < n-1; i++)
    {
        for(j = i+1; j < n; j++)
        {
            if(a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    printf("Seek Sequence: ");

    // Move towards higher cylinder numbers
    for(i = 0; i < n; i++)
    {
        if(a[i] >= head)
        {
            printf("%d ", a[i]);
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    // Move to end of disk
    total += abs(head - (size - 1));
    head = size - 1;

    // Reverse direction
    for(i = n-1; i >= 0; i--)
    {
        if(a[i] < head)
        {
            printf("%d ", a[i]);
            total += abs(head - a[i]);
            head = a[i];
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
